# Copy to docker/.env (gitignored) and fill in.

# From `claude setup-token` on any machine logged into your Claude Max plan.
# The Agent SDK draws from your plan's usage limits with this token.
CLAUDE_CODE_OAUTH_TOKEN=

# Unlocks the app. Long and unique: whoever has it spends your Claude plan.
CAMENA_PASSCODE=

CAMENA_OWNER_NAME=Dennis
CAMENA_TIMEZONE=America/Denver
CAMENA_VAPID_CONTACT=mailto:you@example.com

# Optional: pin a model (default = Claude Code's default for your plan).
# CAMENA_MODEL=claude-opus-5-5
# Close the warm Claude session after this many idle minutes.
# CAMENA_SESSION_IDLE_MINUTES=20
